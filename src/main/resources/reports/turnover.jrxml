	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<style name="SlowStyle" mode="Transparent" backcolor="#B30502" pattern="">
		<conditionalStyle forecolor="#030101" backcolor="#D42D2A">
			<conditionExpression><![CDATA[$F{status}.equals("SLOW-MOVING")]]></conditionExpression>
		</conditionalStyle>
	</style>
	<parameter name="P_YEAR" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[2026]]></defaultValueExpression>
	</parameter>
	<parameter name="P_QUARTER" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[3]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT t.*,
  CASE WHEN t.turnover_ratio < 0.25
         OR (t.supplier_warranty_end <= DATE_ADD(CURDATE(), INTERVAL 6 MONTH) AND t.stock_qty > 0)
       THEN 'SLOW-MOVING' ELSE 'OK' END AS status
FROM (
  SELECT h.item_code, h.brand, h.model, h.category,
         h.stock_qty, h.unit_price,
         h.stock_qty * h.unit_price AS capital_tied,
         h.warranty_months,
         COALESCE(SUM(d.qty),0) AS units_sold,
         COUNT(DISTINCT c.customer_id) AS buyers,
         COALESCE(ROUND(COALESCE(SUM(d.qty),0) /
             NULLIF(h.stock_qty + COALESCE(SUM(d.qty),0),0), 2), 0) AS turnover_ratio,
         DATEDIFF(CURDATE(), h.date_received) AS days_in_stock,
         DATE_ADD(h.date_received, INTERVAL h.warranty_months MONTH) AS supplier_warranty_end
  FROM inventory_hardware h
  LEFT JOIN sale_details d ON d.item_id = h.item_id
  LEFT JOIN sales_orders o ON o.order_id = d.order_id
       AND YEAR(o.order_date) = $P{P_YEAR} AND QUARTER(o.order_date) = $P{P_QUARTER}
  LEFT JOIN customers c ON c.customer_id = o.customer_id
  GROUP BY h.item_id
) t
ORDER BY t.category, t.turnover_ratio ASC, t.capital_tied DESC]]></query>
