<jasperReport name="sales_history" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="052da07f-a333-4e86-a711-5e28e63f84d2">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SolarPOS_DB"/>
	<parameter name="P_FROM_DATE" class="java.lang.String"/>
	<parameter name="P_TO_DATE" class="java.lang.String"/>
	<parameter name="P_CUSTOMER" class="java.lang.String"/>
	<parameter name="P_REPORT_TITLE" class="java.lang.String">
		<defaultValueExpression><![CDATA["Sales History Report"]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    o.order_id,
    c.name            AS customer_name,
    c.type            AS customer_type,
    c.address,
    u.username        AS cashier,
    o.order_date,
    o.subtotal,
    o.discount,
    o.warranty_fees,
    o.tax,
    o.grand_total,
    o.down_payment,
    o.balance_due,
    o.total_kw,
    COUNT(d.detail_id) AS item_count,
    SUM(d.qty)         AS total_units
FROM sales_orders o
JOIN customers        c ON c.customer_id = o.customer_id
JOIN users            u ON u.user_id     = o.user_id
JOIN sale_details     d ON d.order_id    = o.order_id
WHERE
    ($P{P_FROM_DATE} IS NULL OR DATE(o.order_date) >= $P{P_FROM_DATE})
AND ($P{P_TO_DATE}   IS NULL OR DATE(o.order_date) <= $P{P_TO_DATE})
AND ($P{P_CUSTOMER}  IS NULL OR c.name LIKE $P{P_CUSTOMER})
GROUP BY o.order_id
ORDER BY o.order_date DESC]]></query>
